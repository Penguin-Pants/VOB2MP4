{
  "name": "vob2mp4",
  "version": "0.1.0",
  "description": "Convert and split DVD VOB rips into per-episode MP4 files (local Windows desktop app).",
  "author": "twosleeps",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node --import tsx --test src/main/input.test.ts src/main/ffprobe.test.ts src/main/preview.test.ts src/main/segments.test.ts src/main/naming.test.ts src/main/exportArgs.test.ts",
    "fetch-ffmpeg": "node scripts/download-ffmpeg.mjs",
    "build:win": "electron-vite build && electron-builder --win --config electron-builder.yml"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
